  },
  "layer": [
    {
      "transform": [
        {
          "filter": {
            "field": "series",
            "oneOf": [
              "done",
              "in progress",
              "refined",
              "backlog"
            ]
          }
        }
      ],
      "mark": {
        "type": "area",
        "opacity": 0.85,
        "line": true
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "temporal",
          "title": null,
          "scale": {
            "type": "utc"
          },
          "axis": {
            "format": "%b %Y",
            "tickCount": "month"
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "title": "Points",
          "scale": {
            "zero": true
          },
          "stack": "zero"
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "done",
              "in progress",
              "refined",
              "backlog"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#999999"
            ]
          },
          "legend": {
            "orient": "bottom"
          }
        },
        "order": {
          "field": "order",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "series",
            "type": "nominal",
            "title": "Series"
          },
          {
            "field": "x",
            "type": "temporal",
            "timeUnit": "utcyearmonthdate",
            "title": "Week of",
            "format": "%Y-%m-%d"
          },
          {
            "field": "y",
            "type": "quantitative",
            "title": "Points"
          }
        ]
      }
    }
  ]
}
