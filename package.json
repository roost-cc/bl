{
  "name": "bl",
  "version": "0.1.0",
  "description": "A file-based backlog CLI: theme, epic, feature and story workflow over a single shared backlog repo, with headless agent runs",
  "type": "module",
  "bin": {
    "bl": "./bin/bl"
  },
  "scripts": {
    "test": "bash test/helpers/run-parallel.sh test 'npm run' test:unit test:integration test:cli test:top test:next",
    "test:unit": "bash test/helpers/without-repo-env.sh node --test --test-concurrency=${BL_TEST_CONCURRENCY:-8} 'test/unit/*.test.js'",
    "test:integration": "bash test/helpers/without-repo-env.sh node --test --test-concurrency=${BL_TEST_CONCURRENCY:-8} 'test/integration/*.test.js'",
    "test:cli": "bash test/helpers/without-repo-env.sh bash test/cli/run-all.sh",
    "test:top": "cd top && go test ./...",
    "test:next": "bash test/helpers/without-repo-env.sh node --test --test-concurrency=${BL_TEST_CONCURRENCY:-8} 'next/**/*.test.js'",
    "test:e2e": "bash test/helpers/without-repo-env.sh bash test/e2e/run-all.sh",
    "test:all": "npm test && npm run test:e2e"
  },
  "private": true,
  "license": "ISC",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@marcbachmann/cel-js": "8.0.0",
    "ajv": "8.20.0",
    "argparse": "2.0.1",
    "fastest-levenshtein": "1.0.16",
    "fs-ext": "2.1.1",
    "json-merge-patch": "1.0.2",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-table": "2.0.1",
    "mdast-util-gfm-task-list-item": "2.0.1",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "mustache": "4.2.0",
    "shell-quote": "1.12.0",
    "string-width": "8.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "node-pty": "1.1.0",
    "replay": "github:roost-cc/replay#3ebf32b9cff4f9194fe1d856c6c9f2bd11b0c462"
  },
  "allowScripts": {
    "fs-ext@2.1.1": true,
    "node-pty@1.1.0": true
  }
}
