{
  "name": "bl",
  "version": "0.1.0",
  "description": "A file-based backlog CLI: theme, epic, feature and story workflow over a single shared backlog repo, with headless agent runs",
  "type": "module",
  "bin": {
    "bl": "./bin/bl"
  },
  "scripts": {
    "test": "bash test/helpers/run-parallel.sh test 'npm run' test:unit test:integration test:cli",
    "test:unit": "bash test/helpers/without-repo-env.sh node --test --test-concurrency=${BL_TEST_CONCURRENCY:-8} 'test/unit/*.test.js'",
    "test:integration": "bash test/helpers/without-repo-env.sh node --test --test-concurrency=${BL_TEST_CONCURRENCY:-8} 'test/integration/*.test.js'",
    "test:cli": "bash test/helpers/without-repo-env.sh bash test/cli/run-all.sh",
    "test:e2e": "bash test/helpers/without-repo-env.sh bash test/e2e/run-all.sh",
    "test:all": "npm test && npm run test:e2e"
  },
  "private": true,
  "license": "ISC",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-gfm-table": "2.1.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5"
  }
}
