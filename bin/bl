#!/bin/sh
# bl — file-based backlog CLI.
# Self-locating: follows symlinks to find its installation directory,
# so this works whether invoked via PATH, symlink, or absolute path.
SELF="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
BL_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
# bl's dependencies are installed from the lockfile. The check looks for
# fs-ext's native module (F-104 D1): it exists only when npm ci built it, so it
# also catches an install from before fs-ext or one that skipped its build.
if [ ! -f "$BL_ROOT/node_modules/fs-ext/build/Release/fs_ext.node" ]; then
  echo "bl: $BL_ROOT/node_modules is missing or out of date; install bl's dependencies: npm ci --prefix $BL_ROOT" >&2
  exit 1
fi
exec node "$BL_ROOT/src/bl.js" "$@"
